# === BASE DE DATOS ===
MYSQL_ROOT_PASSWORD=rootpassword_seguro
MYSQL_DATABASE=stackdev_security
MYSQL_USER=stackdev
MYSQL_PASSWORD=password_seguro

# === APLICACION ===
SECRET_KEY=cambia_este_secreto_con_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# === GPS ===
CHECKPOINT_RADIO_METROS=50

# === CORS ===
CORS_ORIGINS=["https://tudominio.com"]

# === UPLOADS ===
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# === ZONA HORARIA ===
# Offset UTC de Chile en horas (entero negativo).
# Invierno (mayo-agosto): -4
# Verano (septiembre-abril): -3
# Ajustar según la época del año o cuando Chile cambie de horario.
CHILE_UTC_OFFSET=-3
